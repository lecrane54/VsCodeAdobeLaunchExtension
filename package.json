    "viewsWelcome": [
      {
        "view": "adobeLaunchProperty",
        "when": "adobeLaunch.state == signedOut",
        "contents": "Sign in with your Adobe IMS Server-to-Server credentials to get started.\n[Sign in to Adobe](command:adobeLaunch.signIn)\nNew here? [Open the setup walkthrough](command:adobeLaunch.openWalkthrough)."
      },
      {
        "view": "adobeLaunchProperty",
        "when": "adobeLaunch.state == noProperty",
        "contents": "You're signed in. Choose the Launch property to work on.\n[Set active property](command:adobeLaunch.setProperty)"
      },
      {
        "view": "adobeLaunchProperty",
        "when": "adobeLaunch.state == notPulled",
        "contents": "This property hasn't been pulled yet. Create a local mirror to browse and edit it.\n[Pull property](command:adobeLaunch.pull)"
      },
      {
        "view": "adobeLaunchChanges",
        "when": "adobeLaunch.state == ready && !adobeLaunch.hasChanges",
        "contents": "No unpushed changes — your local mirror matches Reactor.\nEdit a rule, data element, or extension and it'll show up here."
      },
      {
        "view": "adobeLaunchLibrary",
        "when": "adobeLaunch.state == ready && !adobeLaunch.hasLibrary",
        "contents": "No active library selected. Pick one to see the rules and changes it contains.\n[Set active library](command:adobeLaunch.setLibrary)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adobeLaunch",
          "title": "Launch Tags",
          "icon": "media/launch.svg"
        }
      ]
    },
    "views": {
      "adobeLaunch": [
        {
          "id": "adobeLaunchChanges",
          "name": "Changes",
          "icon": "$(cloud-upload)",
          "when": "adobeLaunch.state == ready"
        },
        {
          "id": "adobeLaunchProperty",
          "name": "Property",
          "icon": "$(cloud)"
        },
        {
          "id": "adobeLaunchLibrary",
          "name": "Library",
          "icon": "$(library)",
          "when": "adobeLaunch.state == ready"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "adobeLaunch.setup",
        "title": "Get started with Launch Tags Editor",
        "description": "Connect to Reactor, pick a property, and mirror it locally so you can edit rules as plain files.",
        "steps": [
          {
            "id": "adobeLaunch.step.signIn",
            "title": "Sign in to Adobe",
            "description": "Add the IMS Server-to-Server credentials from your Adobe Developer Console project. They're stored in VS Code's Secret Storage, never in your workspace.\n[Sign in](command:adobeLaunch.signIn)",
            "media": {
              "markdown": "media/walkthrough/sign-in.md",
              "altText": "Signing in to Adobe"
            },
            "completionEvents": [
              "onContext:adobeLaunch.state != signedOut"
            ]
          },
          {
            "id": "adobeLaunch.step.property",
            "title": "Choose a property",
            "description": "Pick which Launch property to work on. Everything else — rules, data elements, libraries — hangs off this choice.\n[Set active property](command:adobeLaunch.setProperty)",
            "media": {
              "markdown": "media/walkthrough/property.md",
              "altText": "Choosing a Launch property"
            },
            "completionEvents": [
              "onCommand:adobeLaunch.setProperty"
            ]
          },
          {
            "id": "adobeLaunch.step.pull",
            "title": "Pull it locally",
            "description": "Mirror the property to disk as JSON + JS files you can edit, search, and diff.\n[Pull property](command:adobeLaunch.pull)",
            "media": {
              "markdown": "media/walkthrough/pull.md",
              "altText": "Pulling a property to a local mirror"
            },
            "completionEvents": [
              "onContext:adobeLaunch.state == ready"
            ]
          },
          {
            "id": "adobeLaunch.step.push",
            "title": "Edit, review, push",
            "description": "Edits show up under Changes with a badge. Review each one against Reactor, then push into your active library.\n[Open the Launch Tags view](command:adobeLaunchChanges.focus)",
            "media": {
              "markdown": "media/walkthrough/push.md",
              "altText": "Reviewing and pushing changes"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Launch Tags",
      "properties": {
        "adobeLaunch.mirrorPath": {
          "type": "string",
          "default": "",
          "description": "Directory holding local mirrors, one folder per property. Empty = <workspace>/launch_property"
        },
        "adobeLaunch.activePropertyId": {
          "type": "string",
          "default": "",
          "description": "Default property id (e.g. PR8fb5f4098b86443b85d28c1ff98ba3f6) used by commands."
        },
        "adobeLaunch.activeLibraryId": {
          "type": "string",
          "default": "",
          "description": "Active development library id (e.g. LB…) that 'Push to library' targets. Set via 'Launch Tags: Set active library'."
        },
        "adobeLaunch.activeLibraryName": {
          "type": "string",
          "default": "",
          "description": "Display name of the active library, cached for the sidebar. Managed automatically."
        },
        "adobeLaunch.scopes": {
          "type": "string",
          "default": "openid,AdobeID,read_organizations,additional_info.projectedProductContext,session,additional_info.job_function,additional_info.roles",
          "description": "IMS OAuth scopes granted to the credential in Adobe Developer Console."
        },
        "adobeLaunch.platformMirrorPath": {
          "type": "string",
          "default": "",
          "description": "Folder for the read-only AEP / CJA snapshot. Empty = <workspace>/adobe_platform."
        },
        "adobeLaunch.platformSandboxes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "AEP sandboxes to pull schemas and Data Prep mappings from (e.g. [\"prod\"]). Empty = every active sandbox."
        },
        "adobeLaunch.platformIncludeAdhocSchemas": {
          "type": "boolean",
          "default": false,
          "description": "Also pull ad-hoc XDM schemas (generated by Query Service and temporary datasets). These can number in the thousands."
        },
        "adobeLaunch.pullConcurrency": {
          "type": "number",
          "default": 12,
          "description": "Concurrent rule_component fetches during pull."
        },
        "adobeLaunch.requestTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "How long to wait for a single Adobe request before giving up. Without a ceiling a stalled connection leaves a command spinning forever; raise this if Adobe is genuinely slow for you, lower it to fail faster behind a blocking proxy."
        },
        "adobeLaunch.validateDataElementRefs": {
          "type": "boolean",
          "default": true,
          "description": "Warn when _satellite.getVar()/setVar() references a data element name that doesn't exist in the pulled property."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
