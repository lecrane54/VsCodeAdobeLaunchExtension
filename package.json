{
  "name": "launch-tags-editor",
  "displayName": "Launch Tags Editor for Adobe Experience Platform",
  "description": "Pull, edit, and push Adobe Launch (Reactor) web and mobile properties as local JSON + JS files.",
  "version": "0.12.0",
  "publisher": "lecrane",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#EB1000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lecrane54/VsCodeAdobeLaunchExtension.git"
  },
  "homepage": "https://github.com/lecrane54/VsCodeAdobeLaunchExtension#readme",
  "bugs": {
    "url": "https://github.com/lecrane54/VsCodeAdobeLaunchExtension/issues"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "adobe",
    "launch",
    "tags",
    "reactor",
    "analytics",
    "data collection",
    "tag management",
    "mobile"
  ],
  "activationEvents": [
    "workspaceContains:**/.launch-manifest.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adobeLaunch.pull",
        "title": "Pull property",
        "category": "Launch Tags",
        "icon": "$(cloud-download)"
      },
      {
        "command": "adobeLaunch.pullPlatform",
        "title": "Pull AEP schemas, mappings & CJA components",
        "category": "Launch Tags",
        "icon": "$(database)"
      },
      {
        "command": "adobeLaunch.pullFresh",
        "title": "Re-pull property (discards local changes)",
        "category": "Launch Tags"
      },
      {
        "command": "adobeLaunch.pushDryRun",
        "title": "Preview push (dry run)",
        "category": "Launch Tags"
      },
      {
        "command": "adobeLaunch.pushToLibrary",
        "title": "Push to active library",
        "category": "Launch Tags",
        "icon": "$(cloud-upload)",
        "enablement": "adobeLaunch.hasLibrary"
      },
      {
        "command": "adobeLaunch.signIn",
        "title": "Sign in to Adobe",
        "category": "Launch Tags"
      },
      {
        "command": "adobeLaunch.signOut",
        "title": "Sign out",
        "category": "Launch Tags"
      },
      {
        "command": "adobeLaunch.setProperty",
        "title": "Set active property",
        "category": "Launch Tags",
        "icon": "$(list-selection)"
      },
      {
        "command": "adobeLaunch.setLibrary",
        "title": "Set active library",
        "category": "Launch Tags",
        "icon": "$(edit)"
      },
      {
        "command": "adobeLaunch.buildLibrary",
        "title": "Build active library",
        "category": "Launch Tags",
        "icon": "$(rocket)",
        "enablement": "adobeLaunch.hasLibrary"
      },
      {
        "command": "adobeLaunch.selectAllChanges",
        "title": "Select all changes",
        "category": "Launch Tags",
        "icon": "$(check-all)"
      },
      {
        "command": "adobeLaunch.selectNoChanges",
        "title": "Deselect all changes",
        "category": "Launch Tags",
        "icon": "$(close-all)"
      },
      {
        "command": "adobeLaunch.goto",
        "title": "Go to resource…",
        "category": "Launch Tags",
        "icon": "$(search)"
      },
      {
        "command": "adobeLaunch.search",
        "title": "Search rules & code…",
        "category": "Launch Tags",
        "icon": "$(search)"
      },
      {
        "command": "adobeLaunch.addRuleComponent",
        "title": "Add trigger/condition/action…",
        "category": "Launch Tags",
        "icon": "$(add)"
      },
      {
        "command": "adobeLaunch.addTrigger",
        "title": "Add trigger…",
        "category": "Launch Tags",
        "icon": "$(add)"
      },
      {
        "command": "adobeLaunch.addCondition",
        "title": "Add condition (custom code)",
        "category": "Launch Tags",
        "icon": "$(add)"
      },
      {
        "command": "adobeLaunch.addAction",
        "title": "Add action (custom code)",
        "category": "Launch Tags",
        "icon": "$(add)"
      },
      {
        "command": "adobeLaunch.addExtensionCondition",
        "title": "Add condition…",
        "category": "Launch Tags",
        "icon": "$(add)"
      },
      {
        "command": "adobeLaunch.addExtensionAction",
        "title": "Add action…",
        "category": "Launch Tags",
        "icon": "$(add)"
      },
      {
        "command": "adobeLaunch.copyEnvironmentId",
        "title": "Copy App ID / embed code…",
        "category": "Launch Tags",
        "icon": "$(copy)"
      },
      {
        "command": "adobeLaunch.newRule",
        "title": "New rule…",
        "category": "Launch Tags",
        "icon": "$(add)"
      },
      {
        "command": "adobeLaunch.refreshTree",
        "title": "Refresh",
        "category": "Launch Tags",
        "icon": "$(refresh)"
      },
      {
        "command": "adobeLaunch.showStatus",
        "title": "Show unpushed changes",
        "category": "Launch Tags"
      },
      {
        "command": "adobeLaunch.copyResourceId",
        "title": "Copy resource id",
        "category": "Launch Tags",
        "icon": "$(copy)"
      },
      {
        "command": "adobeLaunch.revealInFinder",
        "title": "Reveal in Finder",
        "category": "Launch Tags"
      },
      {
        "command": "adobeLaunch.editComponentConfig",
        "title": "Edit config…",
        "category": "Launch Tags",
        "icon": "$(edit)"
      },
      {
        "command": "adobeLaunch.openRawJson",
        "title": "Open raw JSON",
        "category": "Launch Tags"
      },
      {
        "command": "adobeLaunch.diffChange",
        "title": "Show what changed",
        "category": "Launch Tags",
        "icon": "$(git-compare)"
      },
      {
        "command": "adobeLaunch.revertChange",
        "title": "Revert to baseline",
        "category": "Launch Tags",
        "icon": "$(discard)"
      },
      {
        "command": "adobeLaunch.revertAllChanges",
        "title": "Revert all changes",
        "category": "Launch Tags",
        "icon": "$(discard)"
      },
      {
        "command": "adobeLaunch.openWalkthrough",
        "title": "Open setup walkthrough",
        "category": "Launch Tags",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "adobeLaunch.goto",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "adobeLaunch.state == ready"
